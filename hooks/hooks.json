{
  "description": "Cloud mode only (PUNCHLIST_CLOUD=1): keeps the reviewer read-only, stops the writer from posting reviews, posts the reviewer's verdict, and blocks the session from ending without a review of the PR's latest commit.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/guard.py\"", "timeout": 10 }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "^punchlist:reviewer$",
        "hooks": [
          { "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/post_review.py\"", "timeout": 60 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/require_review.py\"", "timeout": 60 }
        ]
      }
    ]
  }
}
